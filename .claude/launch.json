{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && ./gradlew bootRun --args='--spring.profiles.active=local'"
      ],
      "port": 8080
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd apps/mobile && npx expo start --web --port 8081"
      ],
      "port": 8081
    }
  ]
}
